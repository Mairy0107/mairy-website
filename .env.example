# 复制为仓库根目录的 .env，填写现有云 MySQL。不要提交真实密码。
# Spring Boot 会读取该文件；已经导出的环境变量优先，值不会写进日志。

MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=test_01

# 与原先 Node 客户端一致，默认不强制 SSL。云数据库要求加密时改为 REQUIRED。
MYSQL_SSL_MODE=DISABLED

# API 端口。Vite 把 /api 代理到 127.0.0.1:PORT。
PORT=3001

# 本机只监听回环。容器里给 nginx 访问时改为 0.0.0.0。
LISTEN_HOST=127.0.0.1
